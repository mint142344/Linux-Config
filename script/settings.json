{
    ///////////////////////////////////////////////////////////////////////////
    /// General Settings
    ///////////////////////////////////////////////////////////////////////////
    // ------------------------------------------
    // Language
    // ------------------------------------------
    "[cpp]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.stickyScroll.defaultModel": "foldingProviderModel",
        "editor.suggest.insertMode": "replace",
        "editor.wordBasedSuggestions": "off",
        // "editor.defaultFormatter": "ms-vscode.cpptools"
        // "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    // ------------------------------------------
    // Editor
    // ------------------------------------------
    "diffEditor.hideUnchangedRegions.enabled": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.cursorBlinking": "phase",
    "editor.minimap.showSlider": "always",
    "editor.minimap.size": "fill",
    "editor.foldingStrategy": "indentation", // C/C++ 增强预处理法折叠
    "editor.fontFamily": "'JetBrains Mono', 'Consolas'",
    "editor.fontSize": 13,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.lineHeight": 1.5,
    "editor.lineNumbers": "relative",
    "editor.stickyScroll.enabled": false,
    "editor.semanticTokenColorCustomizations": {},
    // ------------------------------------------
    // Workbench
    // ------------------------------------------
    "workbench.colorCustomizations": {
        // 高亮当前行
        "editor.lineHighlightBackground": "#49b2b93d",
        "editor.lineHighlightBorder": "#211e1e10",
    },
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "Default Light+",
    // ------------------------------------------
    // Explorer
    // ------------------------------------------
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    // ------------------------------------------
    // File
    // ------------------------------------------
    "files.associations": {
        ".clang-format": "yaml",
        ".clangd": "yaml",
        "*.log": "log",
        "*.ui": "xml",
        "*vimrc": "Vimscript",
        // MCU 相关
        "*.params": "json",
        "*.qrc": "xml",
        "*.s": "a51",
        "*.scvd": "xml",
        "*.svd": "xml",
        "*.uvoptx": "xml",
        "*.uvprojx": "xml"
    },
    "files.autoGuessEncoding": true,
    // ------------------------------------------
    // Git
    // ------------------------------------------
    "git.autofetch": true,
    "git.autorefresh": false,
    "git.confirmSync": false,
    // ------------------------------------------
    // Copilot 
    // ------------------------------------------
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    // ------------------------------------------
    // Terminal
    // ------------------------------------------
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.defaultProfile.windows": "Windows PowerShell",
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.env.linux": {},
    "terminal.integrated.env.windows": {},
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.profiles.windows": {
        "Git Bash": {
            "args": [],
            "color": "terminal.ansiYellow",
            "icon": "terminal-bash",
            "source": "Git Bash"
        },
        "PowerShell": {
            "args": [
                "-NoExit",
                "-Command",
                "& { [Console]::OutputEncoding = [System.Text.Encoding]::UTF8 }"
            ],
            "color": "terminal.ansiGreen",
            "icon": "terminal-powershell",
            "source": "PowerShell"
        }
    },
    // ------------------------------------------
    // Other Settings
    // ------------------------------------------
    "extensions.ignoreRecommendations": true,
    "search.followSymlinks": false,
    "security.workspace.trust.enabled": false,
    "settingsSync.ignoredSettings": [
        "-clangd.path",
        "cortex-debug.armToolchainPath",
        "cortex-debug.JLinkGDBServerPath",
        "cortex-debug.openocdPath",
        "cortex-debug.stlinkPath",
        "-EIDE.ARM.INI.Path",
    ],
    "settingsSync.ignoredExtensions": [
        "cl.eide",
    ],
    ///////////////////////////////////////////////////////////////////////////
    /// Base Extensions Settings
    ///////////////////////////////////////////////////////////////////////////
    // ------------------------------------------
    // errorLens
    // ------------------------------------------
    "errorLens.excludeBySource": [
        "clang(invalid_declarator_in_function)",
        "clangd(unused-includes)",
        "clang(typecheck_indirection_requires_pointer)",
    ],
    "errorLens.gutterIconsEnabled": true,
    "errorLens.enabledDiagnosticLevels": [
        "error",
        "warning",
        "info",
        "hint"
    ],
    // ------------------------------------------
    // Vim
    // ------------------------------------------
    "vim.vimrc.enable": true,
    "vim.enableNeovim": true,
    "vim.neovimUseConfigFile": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    // "vim.vimrc.path": "使用自动检查目录下的",
    "vim.showMarksInGutter": true, // 显示书签gutter
    "vim.foldfix": true, // vim移动跳过折叠
    "vim.highlightedyank.enable": true, // 高亮复制的部分
    // 下方 vim 组合键用作 IDE
    "vim.handleKeys": {
        "<C-[>": false,
        "<C-]>": false,
        "<C-b>": false, // backward page
        "<C-c>": false,
        "<C-f>": false, // forward page
        "<C-g>": false,
        "<C-h>": false,
        "<C-i>": false,
        "<C-j>": false,
        // 其他
        "<C-k>": false,
        "<C-l>": false,
        "<C-m>": false,
        "<C-n>": false,
        "<C-o>": false,
        "<C-p>": false,
        "<C-s>": false,
        "<C-w>": false,
        "<C-z>": false,
        "<C-t>": false,
    },
    ///////////////////////////////////////////////////////////////////////////
    ///  Extension Settings
    ///////////////////////////////////////////////////////////////////////////
    // ------------------------------------------
    // C_Cpp
    // ------------------------------------------
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.doxygen.generatedStyle": "/**",
    "C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
    "C_Cpp.inlayHints.autoDeclarationTypes.showOnLeft": true,
    "C_Cpp.inlayHints.parameterNames.enabled": true,
    "C_Cpp.inlayHints.referenceOperator.enabled": true,
    "C_Cpp.inlayHints.referenceOperator.showSpace": true,
    // ------------------------------------------
    // C-matic
    // ------------------------------------------
    "C_mantic.contextMenu.switchHeaderSource": false,
    "C_mantic.cpp.bracedInitialization": true,
    "C_mantic.headerGuard.style": "Add #pragma once",
    // ------------------------------------------
    // clangd
    // ------------------------------------------
    "clangd.enable": false,
    "clangd.onConfigChanged": "restart",
    "clangd.arguments": [
        "-background-index",
        "-j=10",
        "--completion-style=detailed", // detailed | bundled
        "--header-insertion=never", // iwyu | never
        "--suggest-missing-includes",
        "--pretty",
        "--clang-tidy",
        "--all-scopes-completion", // default on
        "--function-arg-placeholders=1", // default 1
        // "--query-driver=<glob>",
        // "--compile-commands-dir=${workspaceFolder}/build/Debug",
        // "--compile-commands-dir=${workspaceFolder}/out/build/Linux-Release",
    ],
    // ------------------------------------------
    // CMake 
    // ------------------------------------------
    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "cmake.showNotAllDocumentsSavedQuestion": false,
    "cmake.generator": "Ninja",
    "cmake.useCMakePresets": "always",
    "cmake.options.statusBarVisibility": "visible",
    "cmake.pinnedCommands": [
        "cmake.buildTarget",
        "workbench.action.tasks.configureTaskRunner",
        "cmake.editCacheUI",
        "cmake.selectLaunchTarget",
        "cmake.install",
        "cmake.cleanRebuild",
    ],
    // ------------------------------------------
    // Cortex-Debug
    // ------------------------------------------
    "cortex-debug.liveWatchRefreshRate": 300,
    "cortex-debug.armToolchainPath.windows": "C:/Users/14234/.eide/tools/gcc_arm/bin",
    "cortex-debug.JLinkGDBServerPath.windows": "C:/Users/14234/.eide/tools/jlink/JLinkGDBServerCL.exe",
    "cortex-debug.openocdPath.windows": "C:/Users/14234/.eide/tools/openocd_7a1adfbec_mingw32/bin",
    "cortex-debug.stlinkPath.windows": "C:/Users/14234/.eide/tools/st_cube_programer/bin",
    // ------------------------------------------
    // EIDE
    // ------------------------------------------
    "EIDE.ARM.ARMCC5.InstallDirectory": "C:/Keil_v5/ARM/ARMCC",
    "EIDE.ARM.ARMCC6.InstallDirectory": "C:/Keil_v5/ARM/ARMCLANG",
    "EIDE.ARM.GCC.InstallDirectory": "${userHome}/.eide/tools/gcc_arm",
    "EIDE.ARM.INI.Path": "c:/Keil_v5/TOOLS.INI",
    "EIDE.Cppcheck.ExecutablePath": "${userRoot}/.eide/tools/cppcheck/cppcheck.exe",
    "EIDE.JLink.InstallDirectory": "${userHome}/.eide/tools/jlink",
    "EIDE.OpenOCD.ExePath": "${userHome}/.eide/tools/openocd_7a1adfbec_mingw32/bin/openocd.exe",
    "EIDE.Option.EnableTelemetry": false,
    "EIDE.Option.SilentWhenBuildOrFlash": false,
    "EIDE.STLink.ExePath": "${userHome}/.eide/tools/st_cube_programer/bin/STM32_Programmer_CLI.exe",
}